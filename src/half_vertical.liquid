{% assign svg_id = "dwd-half_vertical" | append_random %}
<div class="w--full h--full">
  {% if days.size > 0 %}
    <svg id="{{ svg_id }}" class="block w--full h--full" data-dwd-view="half_vertical" viewBox="0 0 400 480" preserveAspectRatio="xMidYMid meet"></svg>
  {% else %}
    {{ dwd_empty }}
  {% endif %}
</div>
