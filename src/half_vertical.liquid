{% assign svg_id = "dwd-half_vertical" | append_random %}
<div class="dwd-root">
  {% if days.size > 0 %}
    <svg id="{{ svg_id }}" class="dwd-svg" data-dwd-view="half_vertical" viewBox="0 0 400 480" preserveAspectRatio="xMidYMid meet"></svg>
  {% else %}
    <div class="dwd-empty">{% if dwd_lang == "de" %}Keine Wetterdaten verfügbar{% else %}No weather data available{% endif %}</div>
  {% endif %}
</div>
